  m_Script: {fileID: 11500000, guid: 07ef1d487cd49439481de7d18c62af89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BoundaryClipTrigger
  triggeredClip: {fileID: 8300000, guid: 3a4b3961f4f774e0ca8753f124625f98, type: 3}
  subtitleLines:
  - text: "\u2026Is this it? Well, how disappointing\u2026. "
    timeStartMilliseconds: 0
    durationMilliseconds: 4000
  - text: 'This is on you, you know! '
    timeStartMilliseconds: 4800
    durationMilliseconds: 2200
  - text: 'You skipped our chance for The Trolley Experience, or heck, even tying
      yourself to the tracks! '
    timeStartMilliseconds: 7100
    durationMilliseconds: 6000
  - text: 'We could be riding a roller coaster right now. Instead we''re falling
      into infinity here. '
    timeStartMilliseconds: 13400
    durationMilliseconds: 6000
  - text: '*frustrated grunts* '
    timeStartMilliseconds: 21000
    durationMilliseconds: 1400
