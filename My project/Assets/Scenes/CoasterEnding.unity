  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 258030084}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03a532e85c2b4184b99458b30c016743, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RepeatingClipTrigger
  entries:
  - clip: {fileID: 8300000, guid: 15c1d254da29b47f0a6f56b3d1ac71bf, type: 3}
    subtitleLines:
    - text: "There\u2019s really nothing over there contestant."
      timeStartMilliseconds: 0
      durationMilliseconds: 2400
    - text: "Come back to the stage and let\u2019s finish this with a blast\u2026
        or five blasts."
      timeStartMilliseconds: 2900
      durationMilliseconds: 5600
  - clip: {fileID: 8300000, guid: 3a21eca65819442059ccd4391120e461, type: 3}
    subtitleLines:
    - text: "That\u2019s more like it, getting back to business!"
      timeStartMilliseconds: 0
      durationMilliseconds: 3200
  - clip: {fileID: 8300000, guid: f30ed7b4523404e98b7d4e95915556ff, type: 3}
    subtitleLines:
    - text: No no no! Come back!
      timeStartMilliseconds: 0
      durationMilliseconds: 1400
  - clip: {fileID: 8300000, guid: b4bc6e0f7731546adb40b7ab7ab1fe54, type: 3}
    subtitleLines:
    - text: "You can\u2019t toy with me like this contestant."
      timeStartMilliseconds: 0
      durationMilliseconds: 2600
  - clip: {fileID: 8300000, guid: 2ccf2f2ecd4714963b0c51e2b069d04e, type: 3}
    subtitleLines:
    - text: No.
      timeStartMilliseconds: 0
      durationMilliseconds: 700
  cooldown: 2
